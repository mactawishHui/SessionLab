{
  "manifest_version": 3,
  "name": "Session Lab Native",
  "version": "1.0.1",
  "minimum_chrome_version": "125",
  "description": "原生 Chrome 分组会话：分组独立登录、默认继承当前登录、自定义 Header 与分组缓存。",
  "permissions": [
    "debugger",
    "cookies",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "scripting",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Session Lab Native · 分组会话",
    "default_popup": "popup.html"
  },
  "key": ""
}
